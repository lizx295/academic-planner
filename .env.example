# ─────────────────────────────────────────────────────────────────────────────
# Academic Planner · variables de entorno
#
# Desarrollo local sin Docker:
#   cp .env.example .env.local
#   docker compose up -d db
#   npm run dev
#
# Con Docker Compose basta `docker compose up --build` (lee este archivo como
# referencia de valores; las variables ya tienen valores por defecto).
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Supabase en producción).
DATABASE_URL=postgres://planner:planner@localhost:5432/academic_planner
# disable | require | no-verify. En Supabase normalmente no hace falta.
# DATABASE_SSL=no-verify
# DATABASE_POOL_MAX=5

# Seguridad. Genera valores largos y distintos en producción:
#   openssl rand -base64 48
AUTH_SECRET=cambia-esta-clave-larga-y-aleatoria
APP_ENCRYPTION_KEY=cambia-esta-clave-de-cifrado-de-32-o-mas-bytes

# Solo correos de esta lista de dominios pueden iniciar sesión.
ALLOWED_EMAIL_DOMAINS=espol.edu.ec

# Cuenta administradora inicial (se crea sola en el primer arranque).
ADMIN_EMAIL=admin@espol.edu.ec
ADMIN_PASSWORD=AdminEspol2026!
ADMIN_NAME=Administrador

# Cuenta demo con contraseña temporal (útil para probar el flujo completo).
# Pon SEED_DEMO=false en producción si no la quieres.
SEED_DEMO=true
DEMO_EMAIL=demo@espol.edu.ec
DEMO_PASSWORD=Demo-2026

# Web Push (VAPID). Genera un par con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@espol.edu.ec

# Aula Virtual ESPOL (Moodle). Los usuarios conectan sus propias credenciales
# dentro de la app; esto solo define el portal.
AULAVIRTUAL_BASE_URL=https://aulavirtual.espol.edu.ec

# Secreto para el cron de recordatorios (/api/cron/reminders).
# Vercel Cron lo envía como Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=cambia-este-secreto-de-cron

# Opcional: IA de visión para escanear imágenes de calendarios con mayor
# precisión. Sin esta clave se usa OCR local (Tesseract.js) en el navegador.
# OPENAI_API_KEY=sk-...

# Opcional: activa la salida standalone al construir la imagen Docker.
# APP_STANDALONE=true

# Opcional: URL pública usada en los ejemplos de atajos y en el QR.
# NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
